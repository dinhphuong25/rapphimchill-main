{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hiphim",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-02-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "HIPHIM_DB",
			"database_name": "hiphim-users",
			"database_id": "a5300649-2281-459d-8f57-a0e6f3c5dda7"
		}
	],
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "hiphim"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"vars": {
		"DATABASE_URL": "postgresql://neondb_owner:npg_ImaUR5q9jhyF@ep-tiny-wave-awkfe27v-pooler.c-12.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require",
		"USER_JWT_SECRET": "hiphim_user_jwt_secret_key_2026_super_secure",
		"ADMIN_JWT_SECRET": "hiphim_admin_jwt_secret_key_2026_super_secure",
		"EMAIL_FROM": "Hi Phim <noreply@hiphim.one>"
	}
}
